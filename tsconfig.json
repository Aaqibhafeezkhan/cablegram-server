{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true
  },
  "include": [
    "packages/server-core/src/**/*.ts",
    "apps/community/src/**/*.ts",
    "tests/community/**/*.ts"
  ]
}
