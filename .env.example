# Domain for automatic HTTPS via Caddy (or leave unset for LAN-only HTTP)
CABLEGRAM_DOMAIN=cablegram.example.com

# Public base URL seen by phones and TVs
PUBLIC_BASE_URL=https://cablegram.example.com

# Set to true when running behind an HTTPS reverse proxy
REQUIRE_TLS=true

# Trust X-Forwarded-For from the proxy for rate limits. Set to false if the server port is exposed directly.
TRUST_PROXY=true

# Optional comma-separated web remote / TV web origins allowed by CORS
WEB_APP_ORIGINS=https://tv.cablegram.app

# Optional Telegram application credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional secrets (if omitted, generated automatically in /data/secrets.json with 0600 permissions)
# JWT_SECRET=
# PIN_PEPPER=
